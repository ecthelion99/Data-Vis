{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Energy Generation Per Capita",
  "width": "container",
  "height": 200,
  "projection": {"type": "equirectangular"},
  "data": {
    "url": "https://raw.githubusercontent.com/ecthelion99/Data-Vis/refs/heads/master/data/australian_energy_states.csv"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2022,
      "bind": {
        "input": "range",
        "min": 2008,
        "max": 2022,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/ecthelion99/Data-Vis/refs/heads/master/data/Australianstates.topojson",
          "format": {
            "type": "topojson",
            "feature": "STE_2016_AUST"
          }
        },
        "key": "properties.STE_NAME16"
      },
      "as": "geo"
    },
    {
      "calculate": "datum.Value_Normalized * 1000000",
      "as": "Value_Normalized_kWh"
    },
    {
      "filter": "datum.Energy_Source === 'total' && datum.Year == selectedYear"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "black",
    "strokeWidth": 1
  },
  "encoding": {
    "shape": {"field": "geo", "type": "geojson"},
    "color": {
      "field": "Value_Normalized_kWh",
      "type": "quantitative",
      "scale": {"type": "linear", "scheme": "yellowgreenblue"},
      "legend": {
        "title": "Energy Per Capita (GWh)",
        "orient": "right"
      }
    },
    "tooltip": [
      {"field": "geo.properties.STE_NAME16", "type": "nominal", "title": "State"},
      {"field": "Value_Normalized_kWh", "type": "quantitative", "title":"kWh Per Capita", "format": ",.0f"},
      {"field": "Value", "type": "quantitative", "title": "Total GWh", "format":",.0f"}
    ]
  }
}